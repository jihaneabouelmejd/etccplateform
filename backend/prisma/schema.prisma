// ============================================================================
// ETCC Platform - Prisma Schema
// Gestion complète construction : Devis → BC → BL → Facture → Paiement
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN
  GERANT
  COMPTABLE
  EMPLOYE
}

enum Language {
  FR
  AR
}

enum ProjectStatus {
  ACTIVE
  LATE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum DevisStatus {
  DRAFT
  SENT
  VALIDATED
  REJECTED
  EXPIRED
  CANCELLED
}

enum BCSource {
  INTERNAL       // Créé à partir d'un devis validé
  IMPORTED_OCR   // Importé du client (scan PDF)
  IMPORTED_MANUAL
}

enum BLSource {
  INTERNAL       // Créé depuis un devis / BC validé (généré par la plateforme)
  IMPORTED_OCR   // Importé en externe (scan PDF)
  IMPORTED_MANUAL
}

enum BCStatus {
  OPEN
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum BLStatus {
  PREPARING
  DELIVERED
  SIGNED
  INVOICED
  CANCELLED
}

enum BRStatus {
  ACTIF
  ANNULE
}

enum InvoiceDirection {
  ISSUED    // Facture émise au client
  RECEIVED  // Facture d'achat reçue du fournisseur
}

enum InvoiceSource {
  INTERNAL  // Générée par le système
  SCANNED   // Scannée via OCR
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentType {
  VIREMENT
  ESPECES
  CHEQUE
  EFFET
  AUTRE
}

enum PaymentDirection {
  IN   // Client paye ETCC
  OUT  // ETCC paye fournisseur
}

enum StockMovementType {
  IN          // Achat, retour
  OUT         // BL, consommation
  ADJUSTMENT  // Inventaire
}

enum MovementSource {
  PURCHASE
  BL
  RETURN
  INVENTORY
  MANUAL
}

enum SignatureType {
  UPLOADED
  DRAWN
  PHOTO_STAMP
}

enum ExpenseCategory {
  MATERIEL
  MAIN_OEUVRE
  TRANSPORT
  CARBURANT
  OUTILS
  SOUS_TRAITANCE
  AUTRE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BankMatchStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  NO_INVOICE      // Virement sans facture trouvée !
  MULTI_MATCH
}

enum AlertType {
  NO_INVOICE_FOUND
  UNKNOWN_BENEFICIARY
  AMOUNT_MISMATCH
  DUPLICATE_PAYMENT
  LOW_STOCK
  OVERDUE_INVOICE
  EXPENSE_WITHOUT_RECEIPT
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

// ============================================================================
// COMPANY & SYSTEM
// ============================================================================

/// Informations de la société (utilisées sur tous les PDFs)
model Company {
  id              String   @id @default(uuid())
  
  // Identité
  commercial_name String
  legal_name      String
  legal_form      String?  // SARL, SA, SNC
  capital         Decimal? @db.Decimal(12, 2)
  
  // Identifiants légaux (Maroc)
  ice             String   @unique
  rc              String?
  if              String?  // Identifiant fiscal
  cnss            String?
  patente         String?
  tva_intra       String?
  
  // Adresse
  address_line    String
  postal_code     String?
  city            String
  country         String   @default("Maroc")
  
  // Contact
  phone           String?
  mobile          String?
  email           String?
  website         String?
  
  // Visuel
  logo_url        String?
  primary_color   String?  @default("#F4B315")
  favicon_url     String?
  
  // Banque (sur factures émises)
  bank_name       String?
  rib             String?
  iban            String?
  swift           String?
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  @@map("companies")
}

// ============================================================================
// USERS & AUTH
// ============================================================================

model User {
  id                  String   @id @default(uuid())
  
  // Authentification (Admin crée directement)
  username            String   @unique
  email               String?  @unique
  password_hash       String
  
  // Profil
  first_name          String
  last_name           String
  phone               String?
  avatar_url          String?
  preferred_language  Language @default(FR)
  
  // Rôle & statut
  role                Role
  is_active           Boolean  @default(true)

  // Permissions fines par module (override par utilisateur).
  // Si non-vide, restreint l'accès de cet utilisateur EXACTEMENT à ces modules
  // (en plus/à la place des règles par défaut du rôle) — ex: un EMPLOYE avec
  // allowed_modules=["devis","bc"] a accès complet (CRUD) à Devis et Bons de
  // commande uniquement, même si le rôle EMPLOYE n'y a normalement pas accès.
  // Clés valides: devis, bc, bl, br, invoices, depenses, comptabilite,
  // comptabilite-interne, pdf
  allowed_modules     String[] @default([])
  
  // Tracking
  last_login_at       DateTime?
  password_changed_at DateTime?
  created_by          String?  // UUID de l'Admin qui a créé
  
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  
  // Relations
  signatures          Signature[]
  created_projects    Project[]     @relation("ProjectCreator")
  assigned_tasks      TaskAssignment[]
  created_devis       Devis[]
  created_bcs         BonCommande[]
  created_bls         BonLivraison[]
  created_brs         BonReception[]
  created_invoices    Invoice[]
  submitted_expenses  Expense[]     @relation("ExpenseSubmitter")
  approved_expenses   Expense[]     @relation("ExpenseApprover")
  stock_movements     StockMovement[]
  daily_reports       DailyReport[]
  audit_logs          AuditLog[]
  refresh_tokens      RefreshToken[]
  notifications       Notification[]
  objectifs           Objectif[]
  prestations         Prestation[]
  assigned_projects     ProjectAssignment[]
  assigned_prestations  PrestationAssignment[]
  google_token        UserGoogleToken?
  mail_accounts       MailAccount[]

  @@index([username])
  @@index([email])
  @@map("users")
}

/// Compte(s) email professionnel(s) Hostinger (IMAP/SMTP) associé(s) à un utilisateur.
/// Identifiants saisis une seule fois par l'Admin/Gérant dans la fiche employé —
/// l'utilisateur n'a jamais à les ressaisir. Le mot de passe est chiffré (AES-256-GCM).
/// Un utilisateur a une boîte "principale" (is_primary=true, ex: sa propre adresse) et
/// éventuellement des boîtes "partagées" en plus (ex: contact@etcc.ma consultée par plusieurs employés).
model MailAccount {
  id              String    @id @default(uuid())
  user_id         String

  email_address   String    // adresse Hostinger, ex: ahmed@etcc.ma
  password_enc    String    @db.Text // mot de passe chiffré (IV:authTag:cipherText en base64)
  is_primary      Boolean   @default(true) // boîte personnelle (true) vs boîte partagée ajoutée en plus (false)

  imap_host       String    @default("imap.hostinger.com")
  imap_port       Int       @default(993)
  smtp_host       String    @default("smtp.hostinger.com")
  smtp_port       Int       @default(465)

  is_active       Boolean   @default(true)
  last_error      String?   // dernier message d'erreur de connexion (diagnostic)
  last_checked_at DateTime?

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, email_address])
  @@map("mail_accounts")
}

model RefreshToken {
  id          String   @id @default(uuid())
  token_hash  String   @unique
  user_id     String
  expires_at  DateTime
  revoked_at  DateTime?
  created_at  DateTime @default(now())
  
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id])
  @@map("refresh_tokens")
}

/// Bibliothèque de signatures (réutilisables sur Devis, BL, Factures)
model Signature {
  id          String        @id @default(uuid())
  user_id     String
  name        String
  image_url   String        // S3 URL
  type        SignatureType
  is_default  Boolean       @default(false)
  created_at  DateTime      @default(now())
  
  user             User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  devis            Devis[]
  bls              BonLivraison[]
  invoices         Invoice[]
  bons_commande    BonCommande[]
  
  @@index([user_id])
  @@map("signatures")
}

// ============================================================================
// CLIENTS & FOURNISSEURS
// ============================================================================

model Client {
  id              String   @id @default(uuid())
  
  // Identité
  commercial_name String
  legal_name      String?
  
  // Identifiants légaux
  ice             String?
  rc              String?
  if              String?
  
  // Contact
  contact_person  String?
  phone           String?
  email           String?
  address         String
  city            String?

  // Score (calculé)
  reliability_score Int?   @default(50) // 0-100
  
  // Status
  is_active       Boolean  @default(true)
  archived_at     DateTime?
  
  // Notes privées
  internal_notes  String?  @db.Text
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Relations
  projects        Project[]
  devis           Devis[]
  bcs             BonCommande[]
  bls             BonLivraison[]
  brs             BonReception[]
  invoices        Invoice[]
  marches_prives  MarchePrive[]

  @@index([ice])
  @@index([commercial_name])
  @@map("clients")
}

model Fournisseur {
  id              String   @id @default(uuid())
  
  // Identité
  name            String
  ice             String?  @unique
  rc              String?
  if              String?
  
  // Catégorie
  category        String?  // Matériaux BTP, Transport, Services...
  
  // Contact
  contact_person  String?
  phone           String?
  email           String?
  address         String?
  city            String?
  
  // 🏦 Coordonnées bancaires (CRUCIAL pour matching automatique)
  bank_name       String?
  rib             String?  @unique  // ⭐ Clé de matching
  iban            String?
  swift           String?
  
  // Stats
  is_active       Boolean  @default(true)
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Relations
  invoices        Invoice[]
  payments        Payment[]
  
  @@index([rib])
  @@index([ice])
  @@map("fournisseurs")
}

// ============================================================================
// PROJECTS & TASKS
// ============================================================================

model Project {
  id              String          @id @default(uuid())
  code            String          @unique // ETCC-2026-001
  name            String
  description     String?         @db.Text
  
  // Client & Status
  client_id       String
  status          ProjectStatus   @default(ACTIVE)
  
  // Budget
  budget_amount   Decimal         @db.Decimal(12, 2)
  actual_amount   Decimal         @default(0) @db.Decimal(12, 2)

  // Avancement manuel (0-100)
  progress        Int             @default(0)
  
  // Dates
  start_date      DateTime?
  end_date        DateTime?       // Échéance
  completed_at    DateTime?
  
  // Adresse chantier
  address         String?
  city            String?
  latitude        Float?
  longitude       Float?
  
  // Meta
  created_by      String
  
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  
  // Relations
  client          Client          @relation(fields: [client_id], references: [id])
  creator         User            @relation("ProjectCreator", fields: [created_by], references: [id])
  tasks           Task[]
  devis           Devis[]
  bcs             BonCommande[]
  bls             BonLivraison[]
  brs             BonReception[]
  invoices        Invoice[]
  expenses        Expense[]
  dettes          Dette[]
  stock_movements StockMovement[]
  photos          ProjectPhoto[]
  objectifs       Objectif[]
  assignments     ProjectAssignment[]
  marche_origine  MarchePrive?

  @@index([client_id])
  @@index([status])
  @@map("projects")
}

/// Assignation multiple d'utilisateurs à un chantier (qui travaille sur ce chantier)
model ProjectAssignment {
  id          String   @id @default(uuid())
  project_id  String
  user_id     String
  assigned_at DateTime @default(now())

  project     Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@map("project_assignments")
}

model ProjectPhoto {
  id          String   @id @default(uuid())
  project_id  String
  url         String
  caption     String?
  is_before   Boolean  @default(false)
  is_after    Boolean  @default(false)
  uploaded_at DateTime @default(now())
  
  project     Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  
  @@map("project_photos")
}

model Task {
  id              String           @id @default(uuid())
  project_id      String?
  title           String
  description     String?          @db.Text

  status          TaskStatus       @default(TODO)
  progress        Int              @default(0)  // 0-100
  priority        Int              @default(0)

  due_date        DateTime?
  start_time      String?           // "HH:MM" format
  end_time        String?           // "HH:MM" format
  completed_at    DateTime?

  // Google Calendar sync
  google_event_id String?

  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  project         Project?         @relation(fields: [project_id], references: [id], onDelete: SetNull)
  assignments     TaskAssignment[]
  comments        TaskComment[]
  
  @@index([project_id])
  @@index([status])
  @@map("tasks")
}

model TaskAssignment {
  id          String   @id @default(uuid())
  task_id     String
  user_id     String
  assigned_at DateTime @default(now())
  
  task        Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@unique([task_id, user_id])
  @@map("task_assignments")
}

model TaskComment {
  id         String   @id @default(uuid())
  task_id    String
  user_id    String
  content    String   @db.Text
  photo_url  String?
  created_at DateTime @default(now())
  
  task       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  
  @@map("task_comments")
}

// ============================================================================
// STOCK & PRODUCTS
// ============================================================================

model Product {
  id              String          @id @default(uuid())
  sku             String          @unique
  name            String
  category        String?
  unit            String          // sacs, m³, kg, barres, m²
  
  // Stock
  quantity        Decimal         @default(0) @db.Decimal(10, 2)
  min_threshold   Decimal         @default(0) @db.Decimal(10, 2)
  
  // Prix
  unit_price      Decimal         @db.Decimal(10, 2)
  
  // Meta
  description     String?
  is_active       Boolean         @default(true)
  
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  
  movements       StockMovement[]
  bc_lines        BCLine[]
  bl_lines        BLLine[]
  material_requests MaterialRequest[]
  
  @@index([sku])
  @@map("products")
}

model StockMovement {
  id          String            @id @default(uuid())
  product_id  String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(10, 2)
  source      MovementSource
  
  // Références
  bl_id       String?
  project_id  String?
  
  // Meta
  notes       String?
  created_by  String
  
  created_at  DateTime          @default(now())
  
  product     Product           @relation(fields: [product_id], references: [id])
  project     Project?          @relation(fields: [project_id], references: [id])
  creator     User              @relation(fields: [created_by], references: [id])
  
  @@index([product_id])
  @@index([project_id])
  @@map("stock_movements")
}

model MaterialRequest {
  id          String   @id @default(uuid())
  product_id  String
  project_id  String?
  quantity    Decimal  @db.Decimal(10, 2)
  reason      String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, DELIVERED
  requested_by String
  approved_by String?
  approved_at DateTime?
  created_at  DateTime @default(now())
  
  product     Product  @relation(fields: [product_id], references: [id])
  
  @@map("material_requests")
}

// ============================================================================
// COMMERCIAL DOCUMENTS
// ============================================================================

model Devis {
  id              String      @id @default(uuid())
  number          String      @unique // DEV-2026-0089
  
  // Relations
  client_id       String
  project_id      String?
  prestation_id   String?
  created_by      String
  signature_id    String?

  // Dates
  issue_date      DateTime    @default(now())
  validity_days   Int         @default(30)
  
  // Contenu
  object          String?
  site            String?     // Chantier / site des travaux (optionnel)

  // Montants
  total_ht_brut   Decimal     @db.Decimal(12, 2)   // Avant réduction
  discount_rate   Decimal     @default(0) @db.Decimal(5, 2) // En %
  discount_amount Decimal     @default(0) @db.Decimal(12, 2)
  total_ht_net    Decimal     @db.Decimal(12, 2)   // Après réduction
  tva_rate        Decimal     @default(20) @db.Decimal(5, 2)
  tva_amount      Decimal     @db.Decimal(12, 2)
  total_ttc       Decimal     @db.Decimal(12, 2)
  
  // Conditions
  payment_terms   String?
  notes           String?     @db.Text
  
  // Status
  status          DevisStatus @default(DRAFT)
  sent_at         DateTime?
  validated_at    DateTime?
  rejected_at     DateTime?
  expires_at      DateTime?
  
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  
  // Relations
  client          Client      @relation(fields: [client_id], references: [id])
  project         Project?    @relation(fields: [project_id], references: [id])
  prestation      Prestation? @relation("DevisPrestation", fields: [prestation_id], references: [id], onDelete: SetNull)
  creator         User        @relation(fields: [created_by], references: [id])
  signature       Signature?  @relation(fields: [signature_id], references: [id])
  lines           DevisLine[]
  bcs             BonCommande[]
  prestations     Prestation[] @relation("PrestationOriginDevis")

  @@index([client_id])
  @@index([status])
  @@index([number])
  @@index([prestation_id])
  @@map("devis")
}

model DevisLine {
  id          String  @id @default(uuid())
  devis_id    String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unit_price  Decimal @db.Decimal(10, 2)
  total_ht    Decimal @db.Decimal(12, 2)
  order       Int     @default(0)
  
  devis       Devis   @relation(fields: [devis_id], references: [id], onDelete: Cascade)
  
  @@map("devis_lines")
}

model BonCommande {
  id              String         @id @default(uuid())
  number          String         @unique // BC-2026-0067
  
  // Source
  source          BCSource
  devis_id        String?        // Si INTERNAL
  site            String?        // Chantier / site des travaux (hérité du devis)
  imported_file_url String?      // Si IMPORTED_OCR/MANUAL
  ocr_raw_data    Json?          // Données brutes OCR
  client_number   String?        // Numéro du BC tel qu'émis par le client (ex: MAD1-CO014589)
  
  // Relations
  client_id       String
  project_id      String?
  prestation_id   String?
  created_by      String

  // Dates
  issue_date      DateTime       @default(now())
  expected_delivery DateTime?
  
  // Montants (optionnel, peut venir du devis)
  total_ht        Decimal?       @db.Decimal(12, 2)
  total_ttc       Decimal?       @db.Decimal(12, 2)
  
  // Status
  status          BCStatus       @default(OPEN)

  notes           String?        @db.Text
  signature_id    String?

  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  // Relations
  devis           Devis?         @relation(fields: [devis_id], references: [id])
  client          Client         @relation(fields: [client_id], references: [id])
  project         Project?       @relation(fields: [project_id], references: [id])
  prestation      Prestation?    @relation(fields: [prestation_id], references: [id], onDelete: SetNull)
  creator         User           @relation(fields: [created_by], references: [id])
  signature       Signature?     @relation(fields: [signature_id], references: [id])
  lines           BCLine[]
  bls             BonLivraison[]
  brs             BonReception[]
  invoices        Invoice[]

  @@index([client_id])
  @@index([devis_id])
  @@index([status])
  @@index([prestation_id])
  @@map("bons_commande")
}

model BCLine {
  id          String      @id @default(uuid())
  bc_id       String
  product_id  String?
  description String
  quantity    Decimal     @db.Decimal(10, 2)
  unit_price  Decimal?    @db.Decimal(10, 2)
  total_ht    Decimal?    @db.Decimal(12, 2)
  order       Int         @default(0)
  
  bc          BonCommande @relation(fields: [bc_id], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [product_id], references: [id])
  
  @@map("bc_lines")
}

model BonLivraison {
  id              String       @id @default(uuid())
  number          String       @unique // BL-2026-0055
  
  // Références (CHAIN)
  bc_id           String?      // Optionnel — peut venir direct d'un devis
  devis_id        String?      // Pour traçabilité
  site            String?      // Chantier / site des travaux (hérité du devis)

  // Source
  source          BLSource     @default(INTERNAL)
  imported_file_url String?    // Si IMPORTED_OCR/MANUAL
  ocr_raw_data    Json?        // Données brutes OCR

  // Relations
  client_id       String
  project_id      String?
  prestation_id   String?
  created_by      String
  signature_id    String?

  // Dates
  issue_date      DateTime     @default(now())
  delivery_date   DateTime?
  delivered_at    DateTime?
  signed_at       DateTime?
  
  // Livraison
  delivered_by    String?      // Nom du livreur
  delivery_address String?
  client_signature_url String?  // Photo/signature du client
  
  // Status
  status          BLStatus     @default(PREPARING)
  
  notes           String?      @db.Text
  
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  
  // Relations
  bc              BonCommande? @relation(fields: [bc_id], references: [id])
  client          Client       @relation(fields: [client_id], references: [id])
  project         Project?     @relation(fields: [project_id], references: [id])
  prestation      Prestation?  @relation(fields: [prestation_id], references: [id], onDelete: SetNull)
  creator         User         @relation(fields: [created_by], references: [id])
  signature       Signature?   @relation(fields: [signature_id], references: [id])
  lines           BLLine[]
  invoices        Invoice[]

  @@index([bc_id])
  @@index([client_id])
  @@index([status])
  @@index([prestation_id])
  @@map("bons_livraison")
}

model BLLine {
  id          String       @id @default(uuid())
  bl_id       String
  product_id  String?
  description String
  quantity    Decimal      @db.Decimal(10, 2)
  // ⚠ PAS de prix sur BL (les prix viennent du Devis et apparaissent sur Facture)
  order       Int          @default(0)
  
  bl          BonLivraison @relation(fields: [bl_id], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [product_id], references: [id])

  @@map("bl_lines")
}

// ============================================================================
// BON DE RÉCEPTION (BR) — Module additif et indépendant.
// Document scanné/importé confirmant la réception de la marchandise commandée
// via un BC déjà importé dans la plateforme. Toujours un import manuel simple
// (fichier réel téléversé) — pas de génération interne, pas d'OCR.
// ============================================================================

model BonReception {
  id                 String       @id @default(uuid())
  number             String       @unique // BR-2026-0012

  // Lien obligatoire vers le BC déjà importé auquel ce BR se rattache
  bc_id              String
  site               String?      // Chantier / site (hérité du BC)

  // Fichier réel téléversé (scan/photo du bon de réception signé)
  imported_file_url  String

  // Relations
  client_id          String
  project_id         String?
  created_by         String

  // Dates
  reception_date     DateTime     @default(now()) // Date de réception de la marchandise (sur le document)
  issue_date         DateTime     @default(now()) // Date d'import dans la plateforme

  status             BRStatus     @default(ACTIF)
  notes              String?      @db.Text

  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  bc                 BonCommande  @relation(fields: [bc_id], references: [id])
  client             Client       @relation(fields: [client_id], references: [id])
  project            Project?     @relation(fields: [project_id], references: [id])
  creator            User         @relation(fields: [created_by], references: [id])

  @@index([bc_id])
  @@index([client_id])
  @@index([status])
  @@map("bons_reception")
}

// ============================================================================
// INVOICES (Factures émises ET d'achat)
// ============================================================================

model Invoice {
  id              String           @id @default(uuid())
  number          String           @unique // FAC-2026-0043 ou AUTO
  
  // Direction & Source
  direction       InvoiceDirection // ISSUED (client) ou RECEIVED (fournisseur)
  source          InvoiceSource    // INTERNAL ou SCANNED
  
  // Références (CHAIN pour ISSUED)
  bl_id           String?
  bc_id           String?
  devis_id        String?
  site            String?          // Chantier / site des travaux (hérité du devis)

  // Overrides manuels des références affichées sur le PDF (n'affectent pas le chaînage réel bl_id/bc_id/devis_id)
  ref_devis_override String?       // Si renseigné, remplace le n° devis affiché
  ref_bc_override     String?      // Si renseigné, remplace le n° BC affiché
  ref_bl_override      String?     // Si renseigné, remplace le n° BL affiché

  // Fournisseur (si RECEIVED)
  fournisseur_id  String?
  scanned_file_url String?        // Facture scannée
  ocr_raw_data    Json?
  
  // Relations
  client_id       String?
  project_id      String?
  prestation_id   String?
  created_by      String
  signature_id    String?

  // Dates
  issue_date      DateTime         @default(now())
  due_date        DateTime?        // Échéance
  paid_at         DateTime?
  
  // Montants
  total_ht_brut   Decimal          @db.Decimal(12, 2)
  discount_rate   Decimal          @default(0) @db.Decimal(5, 2)
  discount_amount Decimal          @default(0) @db.Decimal(12, 2)
  total_ht_net    Decimal          @db.Decimal(12, 2)
  tva_rate        Decimal          @default(20) @db.Decimal(5, 2)
  tva_amount      Decimal          @db.Decimal(12, 2)
  total_ttc       Decimal          @db.Decimal(12, 2)
  retenue_garantie_rate Decimal    @default(0) @db.Decimal(5, 2) // % retenue de garantie (affichage PDF uniquement)
  acompte_amount  Decimal          @default(0) @db.Decimal(12, 2)
  amount_paid     Decimal          @default(0) @db.Decimal(12, 2)
  balance         Decimal          @db.Decimal(12, 2) // total_ttc - amount_paid
  
  // Paiement
  payment_method  PaymentType?
  payment_terms   String?
  
  // Status
  status          InvoiceStatus    @default(DRAFT)
  
  // Rapprochement
  reconciled      Boolean          @default(false)
  reconciliation_note String?
  
  notes           String?          @db.Text

  // Personnalisation libre du PDF (rubriques ajoutées, libellés modifiés, couleurs/police, ordre/visibilité des blocs)
  // Structure: { labelOverrides?: Record<string,string>, extraSections?: {id,title,content,position}[],
  //              blockOrder?: string[], hiddenBlocks?: string[], theme?: { accentColor?: string, font?: string } }
  custom_layout   Json?

  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  // Relations
  bl              BonLivraison?    @relation(fields: [bl_id], references: [id])
  bc              BonCommande?     @relation(fields: [bc_id], references: [id])
  fournisseur     Fournisseur?     @relation(fields: [fournisseur_id], references: [id])
  client          Client?          @relation(fields: [client_id], references: [id])
  project         Project?         @relation(fields: [project_id], references: [id])
  prestation      Prestation?      @relation(fields: [prestation_id], references: [id], onDelete: SetNull)
  creator         User             @relation(fields: [created_by], references: [id])
  signature       Signature?       @relation(fields: [signature_id], references: [id])
  lines           InvoiceLine[]
  payments        Payment[]

  @@index([direction])
  @@index([status])
  @@index([client_id])
  @@index([fournisseur_id])
  @@index([bl_id])
  @@index([number])
  @@index([prestation_id])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoice_id  String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unit_price  Decimal @db.Decimal(10, 2)
  total_ht    Decimal @db.Decimal(12, 2)
  order       Int     @default(0)
  
  invoice     Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  
  @@map("invoice_lines")
}

// ============================================================================
// PAYMENTS & BANK RECONCILIATION
// ============================================================================

model Payment {
  id              String            @id @default(uuid())
  type            PaymentType
  direction       PaymentDirection
  amount          Decimal           @db.Decimal(12, 2)
  date            DateTime
  
  // Référence facture (optionnelle pour cash exceptionnels)
  invoice_id      String?
  
  // Contreparties
  fournisseur_id  String?           // Si OUT
  client_name     String?           // Si IN sans client enregistré
  
  // Source
  bank_line_id    String?           @unique  // Si vient du relevé bancaire
  manual          Boolean           @default(false)
  
  // ⚠ Pour cash sans facture
  has_invoice     Boolean           @default(true)
  justification   String?           @db.Text
  receipt_url     String?
  
  // Meta
  reference       String?           // Numéro de chèque, virement, etc.
  notes           String?           @db.Text
  created_by      String
  
  created_at      DateTime          @default(now())
  
  // Relations
  invoice         Invoice?          @relation(fields: [invoice_id], references: [id])
  fournisseur     Fournisseur?      @relation(fields: [fournisseur_id], references: [id])
  bank_line       BankStatementLine? @relation(fields: [bank_line_id], references: [id])
  
  @@index([invoice_id])
  @@index([fournisseur_id])
  @@index([type, direction])
  @@map("payments")
}

model BankStatement {
  id          String              @id @default(uuid())
  file_url    String
  bank_name   String?
  account     String?
  period_from DateTime
  period_to   DateTime
  uploaded_by String
  created_at  DateTime            @default(now())
  
  lines       BankStatementLine[]
  
  @@map("bank_statements")
}

model BankStatementLine {
  id              String           @id @default(uuid())
  statement_id    String
  
  // Contenu parsé
  date            DateTime
  amount          Decimal          @db.Decimal(12, 2)
  is_credit       Boolean          // true = crédit, false = débit
  description     String           @db.Text
  beneficiary     String?
  rib_detected    String?          @db.VarChar(50)
  reference       String?
  
  // Matching
  match_status    BankMatchStatus  @default(UNMATCHED)
  match_score     Int?             // 0-100
  matched_invoice_id String?
  matched_at      DateTime?
  matched_by      String?
  
  // ⚠ Alertes
  alert_id        String?
  
  created_at      DateTime         @default(now())
  
  statement       BankStatement    @relation(fields: [statement_id], references: [id], onDelete: Cascade)
  payment         Payment?
  alert           Alert?           @relation(fields: [alert_id], references: [id])
  
  @@index([statement_id])
  @@index([match_status])
  @@index([rib_detected])
  @@map("bank_statement_lines")
}

// ============================================================================
// ALERTS
// ============================================================================

model Alert {
  id              String      @id @default(uuid())
  type            AlertType
  status          AlertStatus @default(OPEN)
  
  title           String
  description     String?     @db.Text
  
  // Références
  related_type    String?     // "BankStatementLine", "Product", "Invoice"...
  related_id      String?
  
  // Actions
  amount          Decimal?    @db.Decimal(12, 2)
  severity        String      @default("WARN") // INFO, WARN, DANGER
  
  // Assignation
  target_role     Role?
  assigned_to     String?
  resolved_by     String?
  resolved_at     DateTime?
  resolution_note String?     @db.Text
  
  created_at      DateTime    @default(now())
  
  bank_lines      BankStatementLine[]
  
  @@index([status])
  @@index([type])
  @@map("alerts")
}

// ============================================================================
// EXPENSES & REPORTS
// ============================================================================

model Expense {
  id              String          @id @default(uuid())
  project_id      String?

  // Lien prestation (FK réelle vers Prestation)
  prestation_id   String?
  prestation_nom  String?  // dénormalisé pour affichage rapide, resynchronisé à l'écriture

  category        ExpenseCategory
  amount          Decimal         @db.Decimal(10, 2)
  tva_amount      Decimal?        @db.Decimal(10, 2)
  date            DateTime        @default(now())
  description     String

  // Paiement
  payment_method  PaymentType?
  notes           String?         @db.Text

  // Reçu
  receipt_url     String?
  has_receipt     Boolean         @default(false)

  // Validation
  status          ExpenseStatus   @default(PENDING)
  submitted_by    String
  approved_by     String?
  approved_at     DateTime?
  rejection_reason String?

  // Lien automatique depuis paiement main d'oeuvre
  paiement_dette_id String?       @unique

  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  project         Project?        @relation(fields: [project_id], references: [id])
  prestation      Prestation?     @relation(fields: [prestation_id], references: [id], onDelete: SetNull)
  submitter       User            @relation("ExpenseSubmitter", fields: [submitted_by], references: [id])
  approver        User?           @relation("ExpenseApprover", fields: [approved_by], references: [id])
  paiement_dette  PaiementDette?  @relation(fields: [paiement_dette_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([project_id])
  @@index([prestation_id])
  @@map("expenses")
}

model DailyReport {
  id          String   @id @default(uuid())
  user_id     String
  project_id  String?
  date        DateTime
  
  summary     String   @db.Text
  hours_worked Decimal? @db.Decimal(4, 2)
  
  photos      Json?    // Array of URLs
  
  created_at  DateTime @default(now())
  
  user        User     @relation(fields: [user_id], references: [id])
  
  @@index([user_id, date])
  @@map("daily_reports")
}

// ============================================================================
// NOTIFICATIONS & AUDIT
// ============================================================================

model Notification {
  id          String   @id @default(uuid())
  user_id     String
  
  title       String
  message     String   @db.Text
  type        String   // INFO, SUCCESS, WARN, DANGER
  
  link        String?
  is_read     Boolean  @default(false)
  read_at     DateTime?
  
  created_at  DateTime @default(now())
  
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id, is_read])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  user_id     String
  action      String   // CREATE_INVOICE, DELETE_USER, etc.
  entity_type String?
  entity_id   String?
  changes     Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())
  
  user        User     @relation(fields: [user_id], references: [id])
  
  @@index([user_id])
  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

// ============================================================================
// DETTES & PAIEMENTS MAIN D'OEUVRE
// ============================================================================

enum DetteStatut {
  EN_COURS
  PARTIELLE
  SOLDEE
}

model Dette {
  id           String      @id @default(uuid())
  nom          String
  description  String
  montant      Decimal     @db.Decimal(10, 2)
  montant_paye Decimal     @db.Decimal(10, 2) @default(0)
  date         DateTime    @default(now())
  statut       DetteStatut @default(EN_COURS)
  project_id   String?

  // Lien prestation (FK réelle vers Prestation)
  prestation_id  String?
  prestation_nom String?  // dénormalisé pour affichage rapide, resynchronisé à l'écriture

  notes        String?     @db.Text
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  project      Project?         @relation(fields: [project_id], references: [id])
  prestation   Prestation?      @relation(fields: [prestation_id], references: [id], onDelete: SetNull)
  paiements    PaiementDette[]

  @@index([statut])
  @@index([project_id])
  @@index([prestation_id])
  @@map("dettes")
}

model PaiementDette {
  id         String      @id @default(uuid())
  dette_id   String
  montant    Decimal     @db.Decimal(10, 2)
  date       DateTime    @default(now())
  mode       PaymentType @default(ESPECES)
  notes      String?     @db.Text
  created_at DateTime    @default(now())

  dette      Dette       @relation(fields: [dette_id], references: [id], onDelete: Cascade)
  expense    Expense?

  @@index([dette_id])
  @@map("paiements_dettes")
}

// ============================================================================
// AGENDA & OBJECTIFS
// ============================================================================

model Objectif {
  id          String    @id @default(uuid())
  title       String
  description String?   @db.Text

  // null = objectif personnel, non-null = lié à un chantier
  project_id  String?
  user_id     String

  start_date  DateTime?
  end_date    DateTime?
  progress    Int       @default(0)  // 0-100
  completed   Boolean   @default(false)
  completed_at DateTime?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  project     Project?  @relation(fields: [project_id], references: [id], onDelete: SetNull)
  creator     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([project_id])
  @@map("objectifs")
}

enum PrestationStatut {
  EN_COURS
  TERMINEE
  ANNULEE
}

model Prestation {
  id          String           @id @default(uuid())
  nom         String
  client      String
  montant     Decimal          @db.Decimal(12, 2)
  date_debut  DateTime?
  date_fin    DateTime?
  description String?          @db.Text
  statut      PrestationStatut @default(EN_COURS)
  devis_id    String?

  created_by  String
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  creator     User                    @relation(fields: [created_by], references: [id], onDelete: Cascade)
  devis       Devis?                  @relation("PrestationOriginDevis", fields: [devis_id], references: [id], onDelete: SetNull)

  assignments PrestationAssignment[]
  devis_docs  Devis[]                 @relation("DevisPrestation")
  bcs         BonCommande[]
  bls         BonLivraison[]
  invoices    Invoice[]
  expenses    Expense[]
  dettes      Dette[]

  @@index([created_by])
  @@index([devis_id])
  @@map("prestations")
}

model PrestationAssignment {
  id            String     @id @default(uuid())
  prestation_id String
  user_id       String
  assigned_at   DateTime   @default(now())

  prestation    Prestation @relation(fields: [prestation_id], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([prestation_id, user_id])
  @@map("prestation_assignments")
}

model UserGoogleToken {
  id            String   @id @default(uuid())
  user_id       String   @unique
  access_token  String   @db.Text
  refresh_token String?  @db.Text
  expiry_date   BigInt?
  scope         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_google_tokens")
}

// ══════════════════════════════════════════════════════════════════
// MODULE MARCHÉS PRIVÉS
// Module additif et indépendant — aucune table existante n'est modifiée.
// Lien vers Client (optionnel) et Project (optionnel, transformation en chantier).
// Les champs "responsable_id / valide_par_id / responsable_depot_id / created_by"
// référencent des User.id en texte libre (sans contrainte FK) pour ne poser
// aucune relation supplémentaire sur le modèle User existant.
// ══════════════════════════════════════════════════════════════════

enum MarcheStage {
  NOUVEAU         // Nouveaux marchés (détectés)
  RETENU          // Opportunités retenues (acceptées)
  EN_PREPARATION  // Dossiers en préparation
  A_VALIDER       // Dossiers à valider
  DEPOSE          // Dossiers déposés
  GAGNE           // Marchés gagnés
  PERDU           // Marchés perdus
}

enum MarcheDocType {
  ADMINISTRATIF
  TECHNIQUE
  FINANCIER
  AUTRE
}

model MarchePrive {
  id                    String        @id @default(uuid())

  reference             String?
  objet                 String
  client_id             String?
  client_name           String?
  ville                 String?
  budget_estimatif      Decimal?      @db.Decimal(14, 2)
  devise                String?       @default("MAD")
  date_limite           DateTime?
  source                String?
  score_ia              Int?

  stage                 MarcheStage   @default(NOUVEAU)
  refuse_reason         String?       @db.Text

  // Préparation (checklist manuelle — lot 1)
  dossier_admin_ok      Boolean       @default(false)
  dossier_technique_ok  Boolean       @default(false)
  dossier_financier_ok  Boolean       @default(false)

  // Validation
  valide_par_id         String?
  valide_at             DateTime?

  // Dépôt
  date_depot            DateTime?
  responsable_depot_id  String?
  depot_notes           String?       @db.Text

  // Résultat
  cause_perte           String?       @db.Text
  montant_final          Decimal?     @db.Decimal(14, 2)

  // Transformation en chantier (une fois gagné)
  project_id             String?      @unique

  // Sync Calendrier ↔ Agenda (lot 2) — lien optionnel vers une Task existante
  // (module Agenda/Tasks) pour rappeler la date limite. Champ additif,
  // ne modifie pas le modèle Task existant.
  agenda_task_id          String?

  responsable_id         String?
  notes                  String?      @db.Text

  created_by              String?
  created_at              DateTime    @default(now())
  updated_at               DateTime   @updatedAt

  client                   Client?    @relation(fields: [client_id], references: [id], onDelete: SetNull)
  project                  Project?   @relation(fields: [project_id], references: [id], onDelete: SetNull)

  documents                MarcheDocument[]
  depenses                 MarcheDepense[]

  @@index([stage])
  @@index([client_id])
  @@index([date_limite])
  @@map("marches_prives")
}

model MarcheDocument {
  id          String        @id @default(uuid())
  marche_id   String
  type        MarcheDocType @default(AUTRE)
  nom         String
  file_url    String
  obligatoire Boolean       @default(false)
  valide      Boolean       @default(false)
  expire_at   DateTime?
  uploaded_by String?
  created_at  DateTime      @default(now())

  marche      MarchePrive   @relation(fields: [marche_id], references: [id], onDelete: Cascade)

  @@index([marche_id])
  @@map("marche_documents")
}

model MarcheDepense {
  id                        String      @id @default(uuid())
  marche_id                 String
  libelle                   String
  montant                   Decimal     @db.Decimal(12, 2)
  date                      DateTime    @default(now())
  categorie                 String?
  notes                     String?     @db.Text
  transferred_to_expense_id String?
  created_by                String?
  created_at                DateTime    @default(now())

  marche                    MarchePrive @relation(fields: [marche_id], references: [id], onDelete: Cascade)

  @@index([marche_id])
  @@map("marche_depenses")
}

// ══════════════════════════════════════════════════════════════════
// MODULE VEILLE (plateforme de veille commerciale — Entreprises &
// Consultations). Module additif et totalement indépendant — aucune
// table existante n'est modifiée. Lien vers MarchePrive uniquement via
// l'action manuelle "Importer" (Consultation.imported_marche_id) et vers
// User uniquement via un champ user_id texte libre (sans contrainte FK),
// pour ne poser aucune relation supplémentaire sur les modèles existants.
// Pas d'IA / pas d'API payante : extraction par JSON-LD, RSS/Atom,
// sitemap, sélecteurs CSS configurables, heuristiques HTML et regex.
// ══════════════════════════════════════════════════════════════════

enum SourceType {
  RSS
  JSON_LD
  SITEMAP
  HTML_CONFIGURED
  HTML_GENERIC
  PLUGIN
}

enum EntrepriseStatus {
  ACTIF
  A_CONFIGURER
  DESACTIVE
  ERREUR
}

enum EntrepriseType {
  PROMOTEUR
  CONSTRUCTION
  INDUSTRIE
  AUTOMOBILE
  AERONAUTIQUE
  ENERGIE
  HOTELLERIE
  DISTRIBUTION
  SANTE
  LOGISTIQUE
  ENSEIGNEMENT
  AUTRE
}

enum AnnonceStatus {
  NOUVELLE
  VUE
  IMPORTEE
  IGNOREE
  EXPIREE
}

enum ScrapeRunStatus {
  SUCCES
  ECHEC
  PARTIEL
}

// Donneur d'ordre surveillé (promoteur, industriel, hôtelier, etc.)
model Entreprise {
  id                String            @id @default(uuid())
  nom               String
  logo_url          String?
  secteur           String?
  ville             String?
  site_officiel     String?
  type_entreprise   EntrepriseType    @default(AUTRE)
  status            EntrepriseStatus  @default(A_CONFIGURER)

  // Type d'extraction réel (mécanique interne) — affiché en "Générique"
  // (RSS/JSON_LD/SITEMAP/HTML_GENERIC) ou "Spécifique" (HTML_CONFIGURED/PLUGIN)
  // côté interface.
  type              SourceType        @default(HTML_GENERIC)

  // Chemins/URLs prioritaires à surveiller sur le site (ex: /appels-offres,
  // /consultations, /procurement, /fournisseurs, ...)
  pages_surveillees String[]          @default([])

  // Config sélecteurs CSS (mode HTML_CONFIGURED) : { listSelector, titleSelector,
  // linkSelector, dateSelector, budgetSelector, descriptionSelector, ... }
  // Éditable depuis l'admin "Sources à configurer", sans toucher au code.
  config            Json?

  // Clé d'un extracteur spécifique enregistré dans le registre de plugins
  // (mode PLUGIN), ex: "addoha".
  plugin_key        String?

  categorie_defaut  String?
  frequence_cron    String?           @default("0 */6 * * *")

  // Stats dénormalisées (rafraîchies après chaque synchronisation)
  last_sync_at            DateTime?
  last_sync_status        ScrapeRunStatus?
  last_sync_duration_ms   Int?
  last_sync_count         Int?
  total_consultations     Int          @default(0)
  total_erreurs           Int          @default(0)
  taux_reussite           Float?
  derniere_consultation_at DateTime?

  created_by         String?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  consultations       Consultation[]
  logs                ScrapeLog[]
  favoris              EntrepriseFavori[]

  @@index([status])
  @@index([type])
  @@index([type_entreprise])
  @@index([secteur])
  @@index([ville])
  @@map("veille_entreprises")
}

// Favori utilisateur (lien vers User en texte libre, sans FK, cf. note module)
model EntrepriseFavori {
  id            String     @id @default(uuid())
  user_id       String
  entreprise_id String
  created_at    DateTime   @default(now())

  entreprise    Entreprise @relation(fields: [entreprise_id], references: [id], onDelete: Cascade)

  @@unique([user_id, entreprise_id])
  @@map("veille_entreprise_favoris")
}

// Consultation / appel d'offres / opportunité détectée
model Consultation {
  id                String        @id @default(uuid())
  entreprise_id     String

  external_id       String?
  source_url        String

  title             String
  description       String?       @db.Text
  categorie         String?
  secteur           String?
  ville             String?
  budget_estimatif  Decimal?      @db.Decimal(14, 2)
  devise            String?
  maitre_ouvrage    String?
  date_publication  DateTime?
  date_limite       DateTime?
  keywords          String[]      @default([])

  content_hash      String
  raw_data          Json?

  status            AnnonceStatus @default(NOUVELLE)
  imported_marche_id String?

  first_seen_at     DateTime      @default(now())
  last_seen_at      DateTime      @default(now())
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  entreprise        Entreprise    @relation(fields: [entreprise_id], references: [id], onDelete: Cascade)
  history           ConsultationHistory[]

  @@unique([entreprise_id, source_url])
  @@index([content_hash])
  @@index([status])
  @@index([ville])
  @@index([secteur])
  @@index([date_limite])
  @@map("veille_consultations")
}

model ConsultationHistory {
  id            String        @id @default(uuid())
  consultation_id String
  champ         String
  ancienne_valeur String?     @db.Text
  nouvelle_valeur String?     @db.Text
  changed_at    DateTime      @default(now())

  consultation  Consultation  @relation(fields: [consultation_id], references: [id], onDelete: Cascade)

  @@index([consultation_id])
  @@map("veille_consultations_historique")
}

model ScrapeLog {
  id                String          @id @default(uuid())
  entreprise_id     String
  started_at        DateTime        @default(now())
  finished_at       DateTime?
  duration_ms       Int?
  status            ScrapeRunStatus @default(SUCCES)
  annonces_trouvees Int             @default(0)
  annonces_nouvelles Int            @default(0)
  annonces_maj      Int             @default(0)
  erreur            String?         @db.Text

  entreprise        Entreprise      @relation(fields: [entreprise_id], references: [id], onDelete: Cascade)

  @@index([entreprise_id, started_at])
  @@map("veille_scrape_logs")
}