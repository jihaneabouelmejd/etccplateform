# ============================================================================
# ETCC Backend - Environment Variables
# ============================================================================

# App
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://etcc:etcc_secure_password@localhost:5432/etcc_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-to-a-secure-secret-at-least-32-chars-long
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=another-secure-refresh-secret-different-from-above
JWT_REFRESH_EXPIRATION=7d

# bcrypt
BCRYPT_ROUNDS=10

# File storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=etcc_admin
S3_SECRET_KEY=etcc_minio_secret
S3_BUCKET=etcc-files
S3_USE_SSL=false

# OCR (Mindee)
MINDEE_API_KEY=your-mindee-api-key

# Email (optional - disabled by default per user request)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@etcc.ma

# Messagerie professionnelle (Hostinger IMAP/SMTP par utilisateur)
# Clé utilisée pour chiffrer (AES-256-GCM) les mots de passe des boîtes mail en base.
# OBLIGATOIRE en production — générer une valeur aléatoire de 32+ caractères.
MAIL_ENCRYPTION_KEY=change-me-to-a-random-32-plus-character-secret

# Valeurs par défaut proposées à l'Admin lors de l'association d'une boîte Hostinger
# (modifiables par compte si besoin d'un serveur différent)
HOSTINGER_IMAP_HOST=imap.hostinger.com
HOSTINGER_IMAP_PORT=993
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Admin initial (pour le seed)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin2026!Change
INITIAL_ADMIN_FIRSTNAME=Admin
INITIAL_ADMIN_LASTNAME=ETCC
